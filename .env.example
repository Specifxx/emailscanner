# Configure at least one provider. Whichever ones have both an ID and a secret
# show up as sign-in buttons; the others stay hidden.

# --- Google OAuth (console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Local:      http://localhost:3000/api/auth/callback
# Production: https://your-app.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Microsoft / Outlook (entra.microsoft.com -> App registrations) ---
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret-value
# Optional. Defaults to APP_URL + /api/auth/callback, which is what you should
# register as the "Web" redirect URI. Set it only if you need a different host.
# MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Supabase (Dashboard -> Project Settings -> API Keys) ---
SUPABASE_URL=https://your-project.supabase.co
# The secret key (sb_secret_...), never the publishable one.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# --- Session ---
# Signs session cookies and encrypts stored mail tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every session AND makes stored tokens undecryptable,
# so everyone has to reconnect their mailboxes.
SESSION_SECRET=change-me

# Where the app is served from (used for post-login redirects).
APP_URL=http://localhost:3000
