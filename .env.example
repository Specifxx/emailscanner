# --- Google OAuth (console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" on the OAuth client.
# Local:      http://localhost:3000/api/auth/callback
# Production: https://your-app.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# --- Supabase (Dashboard -> Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Session ---
# Signs session cookies and encrypts stored Google tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Where the app is served from (used for post-login redirects).
APP_URL=http://localhost:3000
